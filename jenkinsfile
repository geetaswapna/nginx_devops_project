pipeline {
    agent any

    stages {

        stage('Check Docker') {
            steps {
                sh 'docker --version'
            }
        }

        stage('Build Image') {
            steps {
                sh 'docker build -t my-nginx-image .'
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                    docker rm -f mycontainer || true
                    docker run -d -p 8081:80 --name mycontainer my-nginx-image
                '''
            }
        }
    }
}
