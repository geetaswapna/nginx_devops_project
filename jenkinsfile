pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker run -it --name my-nginx-image .'
            }
        }

       stage('Run Container') {
    steps {
        sh '''
            docker rm -f mycontainer || true
            docker run -d -p 8081:80 --name mycontainer my-nginx-image
        '''
      }
   }
 }
}
