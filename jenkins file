pipeline {

    agent any

    stages {

        stage('Clone Repository') {

            steps {

                git 'https://github.com/geetaswapna/nginx-devops-project.git'

            }
        }

        stage('Build Docker Image') {

            steps {

                sh 'docker build -t nginx-devops:latest .'

            }
        }

        stage('Run Container') {

            steps {

                sh 'docker stop nginx-container || true'
                sh 'docker rm nginx-container || true'

                sh 'docker run -d --name nginx-container -p 80:80 nginx-devops:latest'

            }
        }
    }
}
